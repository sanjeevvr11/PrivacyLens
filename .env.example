# PrivacyLens configuration. Copy this to `.env` and fill in a key to enable the
# optional remote auditor. With no key, the report shows "Remote audit: not
# performed" and every local guarantee still holds.

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional: override the model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
